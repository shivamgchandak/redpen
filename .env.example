# Groq (free tier): https://console.groq.com/keys
# Free limits apply to each model across your whole Groq organisation:
# 30 requests a minute, 1,000 requests a day, 8,000 tokens a minute, 200,000 tokens a day
GROQ_API_KEY=

# MongoDB Atlas (free M0 cluster): Database > Connect > Drivers
MONGODB_URI=
MONGODB_DB=redpen

# Auth.js session secret: generate with `openssl rand -base64 32`
AUTH_SECRET=

# Google OAuth client: console.cloud.google.com > APIs & Services > Credentials
# Authorised redirect URI for local dev: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Vercel Blob (private store): Vercel project > Storage > Blob, then `vercel env pull`
BLOB_READ_WRITE_TOKEN=
